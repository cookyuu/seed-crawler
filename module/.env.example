# Application
DEBUG=false

# Kafka Configuration
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_GROUP_ID=seed-crawler-module-group
KAFKA_REQUEST_TOPIC=job-crawl-request
KAFKA_RESULT_TOPIC=job-crawl-result
KAFKA_AUTO_OFFSET_RESET=earliest

# Crawler Configuration
CRAWLER_DEFAULT_TIMEOUT_SEC=30
CRAWLER_DEFAULT_RETRY_LIMIT=3
CRAWLER_DEFAULT_RETRY_INTERVAL_SEC=60
CRAWLER_USER_AGENT=SeedCrawler/1.0

# Ollama Configuration
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2
OLLAMA_TIMEOUT_SEC=120

# Selenium Configuration
SELENIUM_HEADLESS=true
SELENIUM_PAGE_LOAD_TIMEOUT=30
